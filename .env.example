# ==========================================
# OmniCast Studio Environment Configuration
# ==========================================

# Foundation Models (Google GenAI SDK)
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_MODEL=gemini-3.8-flash
REASONING_MODEL=gemini-3.1-pro

# Observability & Tracing (Langfuse v3)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=omnicast-core-api

# Persistence & Storage
MONGODB_URL=mongodb://localhost:27017/omnicast
MONGODB_DB_NAME=omnicast

# Graph Database (Set USE_KUZU=true for zero-devops embedded, or false for Memgraph/Neo4j)
USE_EMBEDDED_GRAPH=true
KUZU_DATABASE_PATH=./data/kuzu_omnicast
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687

# Text-to-Speech & Audio Synthesis
TTS_ENGINE=kokoro   # Options: kokoro, cartesia
CARTESIA_API_KEY=your-cartesia-api-key-if-using-cloud

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
